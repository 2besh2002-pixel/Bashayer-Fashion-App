# انسخ هذا الملف إلى `.env` فقط عندما تصبحقالخادم (Middleware) جاهزاً.
# Copy this file to `.env` ONLY when the backend is ready. Today the app runs
# with mock data even if this file does not exist.

# مصدر البيانات. القيمة الافتراضية هي mock ولا يتم إرسال أي طلب شبكة.
# Data source. Defaults to mock. Only the exact word "api" enables the API.
EXPO_PUBLIC_DATA_SOURCE=mock

# الرابط الأساسي. التطوير: http://localhost:3000  |  الإنتاج: https://api.mokkafa.com
# Base URL — development / production values are documented in API.md.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# معرّف المتجر من الداشبورد أو Salla Merchant ID. لا تخترعه يدوياً.
# Store ID from the dashboard / Salla merchant ID. Never invent it.
EXPO_PUBLIC_STORE_ID=

# مهلة الطلب بالمللي ثانية (اختياري، الافتراضي 15000).
# Request timeout in ms (optional, default 15000).
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# ملاحظة: المتغيرات التي تبدأ بـ EXPO_PUBLIC_ تُضمَّن في التطبيق،
# لذلك لا تضع أي كلمة مرور أو سر هنا. رمز العميل (JWT) يُحفظ في SecureStore.
# Note: EXPO_PUBLIC_ values are bundled into the app — never put secrets here.
